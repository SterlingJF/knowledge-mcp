{
  "config": {
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD041": false,
    // The module map names a module after its folder, which can share the repo's name.
    "MD024": { "siblings_only": true },
    "MD049": { "style": "asterisk" },
  },
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".claude/**",
    ".venv/**",
    ".evidence/**",
    "runtime/skills/kb-*/**",
    "runtime/knowledge-bus/universes/**",
    // Tests depend on the exact bytes of these fixtures.
    "runtime/tests/fixtures/**",
  ],
}
