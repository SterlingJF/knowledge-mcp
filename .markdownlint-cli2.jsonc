{
  "config": {
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD044": {
      "code_blocks": false,
      "html_elements": false,
      "names": [
        "Claude Code",
        "Codex",
        "GitHub",
        "Homebrew",
        "knowledge-bus",
        "knowledge-mcp",
        "OpenCode",
      ],
    },
    "MD049": { "style": "underscore" },
  },
  "customRules": ["markdownlint-rule-relative-links"],
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".claude/**",
    ".venv/**",
    "runtime/skills/kb-check/**",
    "runtime/skills/kb-evolve/**",
    "runtime/skills/kb-explore/**",
    "runtime/skills/kb-ingest/**",
    "runtime/skills/kb-uncover-decision/**",
    "runtime/skills/kb-uncover-question/**",
    "runtime/knowledge-bus/universes/**",
    // Tests depend on the exact bytes of these fixtures.
    "runtime/tests/fixtures/**",
  ],
}
