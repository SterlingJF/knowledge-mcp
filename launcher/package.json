{
  "name": "launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Menu-bar launcher for the knowledge-mcp engine: settings window, vault list, autostart.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ vite.config.ts",
    "format": "oxfmt --ignore-path=.gitignore src/ vite.config.ts && prettier --write src/ vite.config.ts",
    "format:check": "oxfmt --check --ignore-path=.gitignore src/ vite.config.ts && prettier --check src/ vite.config.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check",
    "clean:macos": "bash scripts/clean-macos-app-state.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "components": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
