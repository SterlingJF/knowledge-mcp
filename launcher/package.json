{
  "name": "knowledge-mcp-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Menu-bar launcher for the knowledge-mcp engine: settings window, vault list, autostart.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "lint": "oxlint --type-aware src/ vite.config.ts",
    "format": "oxfmt --ignore-path=.gitignore src/ vite.config.ts && prettier --write src/ vite.config.ts",
    "format:check": "oxfmt --check --ignore-path=.gitignore src/ vite.config.ts && prettier --check src/ vite.config.ts",
    "sidecars": "bash scripts/build-sidecars.sh",
    "build:dmg": "bash scripts/build-sidecars.sh && tauri build --bundles app,dmg",
    "release": "bash scripts/release-build.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-form": "^1.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.532.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.2.0",
    "@stylistic/eslint-plugin": "^5.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^26.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.5.3",
    "typescript": "7.0.2",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
