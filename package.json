{
  "name": "knowledge-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:frozen": "pnpm install --frozen-lockfile",
    "install:unlock": "pnpm install --no-frozen-lockfile",
    "prepare": "husky",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:justfile && pnpm run check:markdown && pnpm run check:readme-maps && pnpm run check:modules && pnpm run check:placeholders && pnpm run check:types && pnpm run test",
    "check:format": "prettier --check .",
    "check:lint": "oxlint --type-aware tools/",
    "check:justfile": "just check_justfile_format",
    "check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "check:readme-maps": "just check_readme_maps",
    "check:modules": "node tools/modules/check-modules.ts .",
    "check:placeholders": "node tools/placeholders/check-placeholders.ts .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tools/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:markdown": "markdownlint-cli2 --fix \"**/*.md\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.3",
    "oxc-parser": "0.151.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.9",
    "smol-toml": "1.9.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
