{
  "name": "knowledge-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:markdown && pnpm run check:modules && pnpm run check:types && pnpm run test",
    "check:format": "prettier --check .",
    "check:lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error tools",
    "check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "check:modules": "node tools/modules/check-modules.ts .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tools/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:markdown": "markdownlint-cli2 --fix \"**/*.md\""
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "ignore": "7.0.11",
    "knip": "6.41.0",
    "markdownlint-cli2": "0.23.3",
    "markdownlint-rule-relative-links": "5.1.3",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.9",
    "prettier-plugin-toml": "3.0.2",
    "smol-toml": "1.9.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
