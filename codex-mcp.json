{
  "mcpServers": {
    "knowledge-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--package",
        "knowledge-mcp",
        "--no-dev",
        "--",
        "kb",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": ["KNOWLEDGE_MCP_STATE_DIR", "XDG_STATE_HOME"]
    }
  }
}
