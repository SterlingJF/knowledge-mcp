{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 12 * * *"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Widen peer dependency ranges instead of pinning them.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Review mcp updates by hand. A new mcp release can change the MCP spec revisions the server supports.",
      "matchPackageNames": ["mcp"],
      "automerge": false
    },
    {
      "description": "Update knowledge-bus by hand. Change the pin in runtime/pyproject.toml, run uv lock, then run `just refresh_knowledge_model <tag>`.",
      "matchPackageNames": ["knowledge-bus"],
      "enabled": false
    },
    {
      "groupName": "pydantic",
      "matchPackageNames": ["pydantic"]
    },
    {
      "groupName": "pytest",
      "matchPackageNames": ["pytest"]
    },
    {
      "description": "Pin GitHub Actions to commit SHAs, with the version in a comment.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "timezone": "America/New_York",
  "schedule": ["* 12 * * *"],
  "automergeSchedule": ["* 12 * * *"]
}
