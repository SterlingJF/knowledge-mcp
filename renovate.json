{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 12 * * *"]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates merge once CI passes; majors wait for review.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Peer dependency ranges stay ranges and widen for a new major.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "mcp updates wait for review. Any mcp release can change the MCP revisions knowledge-mcp speaks.",
      "matchPackageNames": ["mcp"],
      "automerge": false
    },
    {
      "description": "knowledge-bus moves with `just refresh_knowledge_model <tag>`, which copies the universe specs and skills at the tag of the release archive the package is pinned to.",
      "matchPackageNames": ["knowledge-bus"],
      "enabled": false
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxc-parser"]
    },
    {
      "groupName": "pydantic",
      "matchPackageNames": ["pydantic"]
    },
    {
      "groupName": "pytest",
      "matchPackageNames": ["pytest"]
    },
    {
      "description": "Actions in the release workflow stay pinned by commit SHA, with the version in a comment.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/release.yml"],
      "pinDigests": true
    }
  ],
  "timezone": "America/New_York",
  "schedule": ["* 12 * * *"],
  "automergeSchedule": ["* 12 * * *"]
}
