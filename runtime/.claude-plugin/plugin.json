{
  "name": "knowledge-mcp",
  "version": "0.3.0",
  "description": "Plain, structured thinking while you work. It's free, open, and local-first.",
  "author": { "name": "Sterling Freeman" },
  "homepage": "https://github.com/SterlingJF/knowledge-mcp",
  "repository": "https://github.com/SterlingJF/knowledge-mcp",
  "license": "MIT",
  "keywords": ["knowledge-mcp", "knowledge-bus", "knowledge-base", "mcp"],
  "skills": "./skills/",
  "mcpServers": {
    "knowledge-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--no-project",
        "--python",
        "3.14",
        "--",
        "python",
        "-m",
        "knowledge_mcp.start"
      ]
    }
  }
}
